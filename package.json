{
  "name": "dsh-session-rotate",
  "version": "0.2.1",
  "description": "DSH context auto-rotation: turn-size and peak-size triggers, handoff excerpt + backup, new session handoff, archive the old one.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "context",
    "session",
    "rotate",
    "compaction"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
